# NIRIKSHAN-AI backend env — copy to .env and fill in real values (never commit .env)
# All vars carry the NIRIKSHAN_ prefix so ambient env from other projects can't leak in.
NIRIKSHAN_DATABASE_URL=postgresql://nirikshan:nirikshan@localhost:5432/nirikshan
NIRIKSHAN_JWT_SECRET=change-me-to-a-long-random-string
NIRIKSHAN_DEMO_TODAY_ISO=2026-09-07
NIRIKSHAN_UPLOAD_DIR=./uploads
NIRIKSHAN_SEED_DEMO=true
